(define (problem minecraft-build)
  (:domain minecraft)

  (:objects
    loc_0_0 loc_0_1 loc_0_2 loc_1_0 loc_1_1 loc_1_2 loc_2_0 loc_2_1 loc_2_2 - location
    b1 b2 b3 - block
  )

  (:init
    (handempty)
    (at-robot loc_0_0)
    (adjacent loc_0_0 loc_1_0)
    (adjacent loc_0_0 loc_0_1)
    (adjacent loc_0_1 loc_1_1)
    (adjacent loc_0_1 loc_0_0)
    (adjacent loc_0_1 loc_0_2)
    (adjacent loc_0_2 loc_1_2)
    (adjacent loc_0_2 loc_0_1)
    (adjacent loc_1_0 loc_0_0)
    (adjacent loc_1_0 loc_2_0)
    (adjacent loc_1_0 loc_1_1)
    (adjacent loc_1_1 loc_0_1)
    (adjacent loc_1_1 loc_2_1)
    (adjacent loc_1_1 loc_1_0)
    (adjacent loc_1_1 loc_1_2)
    (adjacent loc_1_2 loc_0_2)
    (adjacent loc_1_2 loc_2_2)
    (adjacent loc_1_2 loc_1_1)
    (adjacent loc_2_0 loc_1_0)
    (adjacent loc_2_0 loc_2_1)
    (adjacent loc_2_1 loc_1_1)
    (adjacent loc_2_1 loc_2_0)
    (adjacent loc_2_1 loc_2_2)
    (adjacent loc_2_2 loc_1_2)
    (adjacent loc_2_2 loc_2_1)
    (at-block b1 loc_1_2)
    (on-ground b1)
    (clear b1)
    (at-block b2 loc_2_2)
    (on-ground b2)
    (clear b2)
    (at-block b3 loc_1_1)
    (on-ground b3)
    (clear b3)
    (free-ground loc_0_0)
    (free-ground loc_0_1)
    (free-ground loc_0_2)
    (free-ground loc_1_0)
    (free-ground loc_2_0)
    (free-ground loc_2_1)
  )

  (:goal (and
    (at-block b1 loc_2_1)
    (on-ground b1)
    (at-block b2 loc_2_1)
    (on b2 b1)
    (at-block b3 loc_2_1)
    (on b3 b2)
  ))
)
